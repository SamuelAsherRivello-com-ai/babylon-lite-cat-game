{
  "name": "babylon-lite-cat-game",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:typescript-source && npm run typecheck && npm test && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-isolation=none cat-hangout/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:typescript-source": "tsx scripts/check-typescript-source.ts"
  },
  "dependencies": {
    "@babylonjs/lite": "1.32.0",
    "@colyseus/sdk": "^0.17.43",
    "@rmc/multiplayer-client": "https://github.com/SamuelAsherRivello-com-ai/rmc-colyseus-multiplayer-server/releases/download/v0.9.15/rmc-multiplayer-client-0.9.15.tgz",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.71",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
